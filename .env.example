# === Google Gemini ===
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Model (có thể đổi tuỳ nhu cầu)
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=gemini-embedding-001

# === Neo4j Aura (managed cloud, free tier) ===
# Tạo instance tại https://console.neo4j.io → tải file credentials
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# === Supabase (Postgres + Auth + Storage) ===
# Tạo project tại https://supabase.com/dashboard → Settings → API
# Để trống cả nhóm này = dev mode: auth no-op (user giả role admin)
SUPABASE_URL=
# Legacy JWT secret (HS256) — Settings → API → JWT Secret.
# Project dùng JWT signing keys mới thì ĐỂ TRỐNG (backend tự verify qua JWKS).
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# === Redis (hàng đợi ARQ) ===
# Để trống ở local dev — /ingest sẽ chạy đồng bộ, không cần Redis
REDIS_URL=

# === LanceDB ===
# Mặc định: nhúng local tại LANCEDB_PATH. Điền URI db:// + API key để dùng LanceDB Cloud
# (https://cloud.lancedb.com) — máy local/Railway không giữ dữ liệu vector nữa.
LANCEDB_PATH=data/lancedb
LANCEDB_URI=
LANCEDB_API_KEY=
LANCEDB_REGION=us-east-1

# === Local paths ===
DATA_RAW_PATH=data/raw

# === CORS (frontend Next.js) ===
FRONTEND_ORIGIN=http://localhost:3000
